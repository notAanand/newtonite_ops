{
  "name": "newtonite-ops",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --workspace backend run dev",
    "dev:web": "npm --workspace frontend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "test": "npm --workspace backend test && npm --workspace frontend test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "devDependencies": { "prisma": "^6.8.2", "tsx": "^4.19.4", "typescript": "^5.8.3" }
}
