generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkType {
  INCIDENT
  CUSTOMER_ISSUE
  PAYMENT
  COMPLIANCE
  TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Status {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  active             Boolean             @default(true)
  memberships        Membership[]
  assignedItems      WorkItem[]          @relation("Assignee")
  createdItems       WorkItem[]          @relation("Creator")
  activities         ActivityEvent[]
  comments           Comment[]
  idempotencyRecords IdempotencyRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Team {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  memberships Membership[]
  workItems   WorkItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      Role
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
  @@index([teamId, role])
}

model WorkItem {
  id          String          @id @default(cuid())
  title       String
  description String          @db.Text
  type        WorkType
  priority    Priority        @default(MEDIUM)
  status      Status          @default(OPEN)
  teamId      String
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  version     Int             @default(1)
  team        Team            @relation(fields: [teamId], references: [id])
  assignee    User?           @relation("Assignee", fields: [assigneeId], references: [id])
  createdBy   User            @relation("Creator", fields: [createdById], references: [id])
  activities  ActivityEvent[]
  comments    Comment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([teamId, createdAt, id])
  @@index([teamId, status, createdAt, id])
  @@index([teamId, priority, createdAt, id])
  @@index([teamId, assigneeId, createdAt, id])
  @@index([teamId, status, priority])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  workItemId String
  actorId    String
  eventType  String
  details    Json
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([workItemId, createdAt, id])
}

model Comment {
  id         String   @id @default(cuid())
  workItemId String
  authorId   String
  body       String   @db.Text
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([workItemId, createdAt, id])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  key         String
  actorId     String
  scope       String
  fingerprint String
  resourceId  String
  response    Json
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([actorId, scope, key])
  @@index([createdAt])
}

model OutboxJob {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  availableAt DateTime  @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
}
